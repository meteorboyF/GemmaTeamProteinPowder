# Copy this file to .env and paste your real key there. NEVER commit .env.
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# --- optional overrides (defaults live in config.py) ---
# GEMMA_PRIMARY_MODEL=gemma-4-31b-it
# GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434
# THINKING_BUDGET=0
# MAX_OUTPUT_TOKENS=4096
# MODEL_TEMPERATURE=0.1

# --- feature flags (1/0) ---
# ENABLE_LOCAL_FALLBACK=1
# ENABLE_TTS=1
# ENABLE_SAFETY_CHECKS=1
# DEBUG=0
